FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG TARGETARCH
ARG VERSION=dev
ARG REALM_VERSION=v2.9.4
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY scripts ./scripts
RUN GOMAXPROCS=1 GOMEMLIMIT=384MiB CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w -X main.version=$VERSION" -o /relay-control ./cmd/relay-control \
    && mkdir -p /downloads \
    && for arch in amd64 arm64; do GOMAXPROCS=1 GOMEMLIMIT=384MiB CGO_ENABLED=0 GOOS=linux GOARCH=$arch go build -trimpath -ldflags="-s -w -X main.version=$VERSION" -o "/downloads/relay-agent-linux-$arch" ./cmd/relay-agent; done \
    && install -m 0755 scripts/install-agent-online.sh /downloads/install-agent-online.sh \
    && install -m 0755 scripts/update-agent.sh /downloads/update-agent.sh \
    && install -m 0755 scripts/zf.sh /downloads/zf.sh \
    && cd /downloads \
    && sha256sum relay-agent-linux-amd64 > relay-agent-linux-amd64.sha256 \
    && sha256sum relay-agent-linux-arm64 > relay-agent-linux-arm64.sha256 \
    && sha256sum update-agent.sh > update-agent.sh.sha256 \
    && sha256sum zf.sh > zf.sh.sha256
RUN apk add --no-cache curl \
    && curl --proto '=https' --tlsv1.2 -fL --retry 3 "https://github.com/zhboner/realm/releases/download/${REALM_VERSION}/realm-x86_64-unknown-linux-musl.tar.gz" -o /downloads/realm-x86_64-unknown-linux-musl.tar.gz \
    && curl --proto '=https' --tlsv1.2 -fL --retry 3 "https://github.com/zhboner/realm/releases/download/${REALM_VERSION}/realm-aarch64-unknown-linux-musl.tar.gz" -o /downloads/realm-aarch64-unknown-linux-musl.tar.gz \
    && cd /downloads \
    && sha256sum realm-x86_64-unknown-linux-musl.tar.gz > realm-x86_64-unknown-linux-musl.tar.gz.sha256 \
    && sha256sum realm-aarch64-unknown-linux-musl.tar.gz > realm-aarch64-unknown-linux-musl.tar.gz.sha256

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata && addgroup -S relay && adduser -S -G relay relay && mkdir -p /data && chown relay:relay /data
COPY --from=build /relay-control /usr/local/bin/relay-control
COPY --from=build /downloads /opt/relay-downloads
ENV RELAY_DOWNLOAD_DIR=/opt/relay-downloads
USER relay
VOLUME ["/data"]
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/relay-control"]
