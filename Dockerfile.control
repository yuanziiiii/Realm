FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /relay-control ./cmd/relay-control

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata && addgroup -S relay && adduser -S -G relay relay && mkdir -p /data && chown relay:relay /data
COPY --from=build /relay-control /usr/local/bin/relay-control
USER relay
VOLUME ["/data"]
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/relay-control"]
