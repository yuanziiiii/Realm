FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /relay-agent ./cmd/relay-agent

FROM alpine:3.22
RUN apk add --no-cache ca-certificates iproute2 nftables kmod
COPY --from=build /relay-agent /usr/local/bin/relay-agent
ENTRYPOINT ["/usr/local/bin/relay-agent"]
